@page "/dashboard"

@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<PageTitle>Canli Trafik</PageTitle>

<h1>Canli Ag Trafigi</h1>

<p>Baglanti Durumu: @connectionStatus</p>
@if (anormalies.Any()){
    <div class = "mt-3 mb-3">
        <h3 style = color : #b91c1c;> Tespit edilen Anomaliler</h3>
        <ul class = "list-group">
            @foreach(var anomaly in anormalies.Take(10)){
                <li class = "list-group-item" style="border-left : 4px solid #b91c1c;">
                <strong> [@anomaly.RuleName]</strong> - @anomaly.Description
                <span class="text-muted" style="float : right;">@anomaly.Timestamp.ToString("HH:mm:ss")</span>
                </li>
            }
        </ul>
    </div>
}
<table class="table">
    <thead>
        <tr>
            <th>Zaman</th>
            <th>Kaynak IP</th>
            <th>Hedef</th>
            <th>Boyut</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var packet in packets.Take(30))
        {
            <tr>
                <td>@packet.Timestamp.ToString("HH:mm:ss")</td>
                <td>@packet.SourceIp</td>
                <td>@packet.DestinationIp:@packet.DestinationPort</td>
                <td>@packet.SizeBytes byte</td>
            </tr>
        }
    </tbody>
</table>

@code
{
    private HubConnection? hubConnection;

    private List<PacketDisplayModel> packets = new();
    private List<AnormalyDisplayModel> anormalies = new();

    private string connectionStatus = "Bağlanıyor...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5128/packetHub")
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<PacketDisplayModel>(
            "ReceivePacket",
            packet =>
            {
                packets.Insert(0, packet);

                InvokeAsync(StateHasChanged);
            });
        hubConnection.On<AnormalyDisplayModel>("ReceiveAnormaly" , (anormaly) =>
        {
            anormalies.Insert(0, anormaly);
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await hubConnection.StartAsync();

            connectionStatus = "Bağlandı";

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            connectionStatus = "HATA: " + ex.Message;

            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private class PacketDisplayModel
    {
        public string SourceIp { get; set; } = string.Empty;

        public string DestinationIp { get; set; } = string.Empty;

        public int DestinationPort { get; set; }

        public int SizeBytes { get; set; }

        public DateTime Timestamp { get; set; }
    }
    private class AnormalyDisplayModel{
        public string RuleName {get; set;} = string.Empty;
        public string Description {get; set;} = string.Empty;
        public DateTime Timestamp {get; set;}
    }
}