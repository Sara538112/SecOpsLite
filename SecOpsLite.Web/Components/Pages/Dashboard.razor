@page "/dashboard"

@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<PageTitle>Canli Trafik</PageTitle>

<h1>Canli Ag Trafigi</h1>

<p>Baglanti Durumu: @connectionStatus</p>

<table class="table">
    <thead>
        <tr>
            <th>Zaman</th>
            <th>Kaynak IP</th>
            <th>Hedef</th>
            <th>Boyut</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var packet in packets.Take(30))
        {
            <tr>
                <td>@packet.Timestamp.ToString("HH:mm:ss")</td>
                <td>@packet.SourceIp</td>
                <td>@packet.DestinationIp:@packet.DestinationPort</td>
                <td>@packet.SizeBytes byte</td>
            </tr>
        }
    </tbody>
</table>

@code
{
    private HubConnection? hubConnection;

    private List<PacketDisplayModel> packets = new();

    private string connectionStatus = "Bağlanıyor...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        Console.WriteLine(
            "========== DASHBOARD OnAfterRender FIRST RENDER =========="
        );

        hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5128/packetHub")
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<PacketDisplayModel>(
            "ReceivePacket",
            packet =>
            {
                Console.WriteLine(
                    $"[DEBUG] Paket alındı: {packet.SourceIp}"
                );

                packets.Insert(0, packet);

                InvokeAsync(StateHasChanged);
            });

        try
        {
            await hubConnection.StartAsync();

            Console.WriteLine(
                "========== DASHBOARD SIGNALR BAĞLANDI =========="
            );

            connectionStatus = "Bağlandı";

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"[DEBUG] Dashboard SignalR HATASI: {ex}"
            );

            connectionStatus = "HATA: " + ex.Message;

            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private class PacketDisplayModel
    {
        public string SourceIp { get; set; } = string.Empty;

        public string DestinationIp { get; set; } = string.Empty;

        public int DestinationPort { get; set; }

        public int SizeBytes { get; set; }

        public DateTime Timestamp { get; set; }
    }
}